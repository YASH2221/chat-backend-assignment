# Server
NODE_ENV=development
PORT=3000

# PostgreSQL (Supabase Connection String)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chat_backend
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Firebase Admin SDK (choose ONE approach: either FIREBASE_SERVICE_ACCOUNT_PATH or the 3 individual env vars)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional: path to serviceAccountKey.json instead of the 3 vars above
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Optional: set to localhost:8080 if using Firebase Firestore Emulator locally
# FIRESTORE_EMULATOR_HOST=localhost:8080
